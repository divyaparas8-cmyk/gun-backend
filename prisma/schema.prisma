datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String
  employeeId   String    @unique
  email        String    @unique
  passwordHash String
  role         String    @default("Viewer")
  department   String
  status       String    @default("Active") // Active, Inactive
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs      AuditLog[]
  alertRemarks   AlertRemark[]
  ammoTrans      AmmunitionTransaction[]
  accessoryTrans AccessoryTransaction[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  permissions String   @db.Text // JSON array of string permissions: ["dashboard.view", "gun.view", ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Person {
  id                 String   @id @default(uuid())
  fullName           String
  fullNameAr         String?
  employeeId         String   @unique
  phone              String
  department         String
  departmentAr       String?
  rank               String
  rankAr             String?
  designation        String
  designationAr      String?
  idDocument         String   @unique
  address            String   @db.Text
  addressAr          String?  @db.Text
  supervisingOfficer String
  status             String   @default("Active") // Active, Inactive, Blocked
  blockedReason      String?  @db.Text
  avatar             String?  @db.Text
  notes              String?  @db.Text
  notesAr            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leases             Lease[]

  @@map("people")
}

model Gun {
  id               String   @id @default(uuid())
  serialNumber     String   @unique
  gunType          String   // Handgun, Pistol, Shotgun, Rifle, Revolver
  brand            String
  model            String
  modelAr          String?
  calibre          String
  purchaseDate     String
  condition        String   @default("Good") // Excellent, Good, Fair, Damaged, Needs Cleaning
  location         String
  locationAr       String?
  status           String   @default("Available") // Available, Leased, Maintenance, Unavailable
  magazineCapacity Int?     @default(15)
  defaultBullets   Int?     @default(30)
  actionType       String?
  barrelLength     String?
  notes            String?  @db.Text
  notesAr          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  primaryLeases    Lease[]  @relation("PrimaryGun")
  secondaryLeases  Lease[]  @relation("SecondaryGun")
  alerts           Alert[]

  @@map("guns")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  nameAr      String?
  code        String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model StorageLocation {
  id          String   @id @default(uuid())
  name        String   @unique
  nameAr      String?
  room        String?
  type        String   @default("General") // Gun, Ammunition, Accessory, General
  description String?  @db.Text
  status      String   @default("Active") // Active, Maintenance
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("storage_locations")
}

model Ammunition {
  id                String   @id @default(uuid())
  bulletType        String
  bulletTypeAr      String?
  calibre           String   @unique
  availableQuantity Int      @default(0)
  minimumStockLevel Int      @default(500)
  storageLocation   String
  storageLocationAr String?
  condition         String   @default("Good")
  status            String   @default("Healthy") // Healthy, Low Stock
  notes             String?  @db.Text
  notesAr           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      AmmunitionTransaction[]
  alerts            Alert[]

  @@map("ammunition")
}

model AmmunitionTransaction {
  id           String      @id @default(uuid())
  ammunitionId String
  date         DateTime    @default(now())
  type         String      // Stock Received, Bullets Issued, Bullets Returned, Bullets Used, Damaged/Lost, Manual Adjustment
  quantity     Int
  reference    String?
  performedBy  String
  userId       String?
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())

  ammunition   Ammunition  @relation(fields: [ammunitionId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id])

  @@map("ammunition_transactions")
}

model Accessory {
  id                String   @id @default(uuid())
  name              String
  nameAr            String?
  category          String   // Helmets, Gloves, Knee Pads, Body Armor & Vests, Magazines, Holsters, Gun Cases, Cleaning Kits, Safety Equipment, Tactical Gear, Other
  categoryAr        String?
  availableQuantity Int      @default(0)
  totalQuantity     Int      @default(0)
  condition         String   @default("Good")
  storageLocation   String
  storageLocationAr String?
  assignedPerson    String?
  notes             String?  @db.Text
  notesAr           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions      AccessoryTransaction[]
  alerts            Alert[]

  @@map("accessories")
}

model AccessoryTransaction {
  id          String    @id @default(uuid())
  accessoryId String
  date        DateTime  @default(now())
  type        String    // Stock Received, Issued, Returned, Damaged/Lost, Manual Adjustment
  quantity    Int
  reference   String?
  performedBy String
  userId      String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@map("accessory_transactions")
}

model Lease {
  id                         String      @id @default(uuid())
  personId                   String
  gunId                      String
  gunBulletsIssued           Int?        @default(0)
  pistolId                   String?
  pistolBulletsIssued        Int?        @default(0)
  weaponsJson                String?     @db.Text // JSON string of LeaseGunItem[]
  issueDate                  String
  issueTime                  String
  expectedReturnDate         String
  expectedReturnTime         String
  purpose                    String
  locationOfUse              String
  bulletsIssued              Int         @default(0)
  accessoriesIssuedJson      String      @db.Text // JSON array of string accessory names
  issuingOfficer             String
  receiverSignatureConfirmed Boolean     @default(true)
  status                     String      @default("Active") // Active, Due Today, Overdue, Returned, Cancelled
  notes                      String?     @db.Text
  overdueDurationHours       Int?        @default(0)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  person                     Person      @relation(fields: [personId], references: [id])
  gun                        Gun         @relation("PrimaryGun", fields: [gunId], references: [id])
  pistol                     Gun?        @relation("SecondaryGun", fields: [pistolId], references: [id])
  returnRecord               GunReturn?
  alerts                     Alert[]
  remarks                    AlertRemark[]

  @@map("leases")
}

model GunReturn {
  id                         String   @id @default(uuid())
  leaseId                    String   @unique
  actualReturnDate           String
  actualReturnTime           String
  gunCondition               String   // Good, Damaged, Needs Cleaning
  bulletsIssued              Int      @default(0)
  bulletsUsed                Int      @default(0)
  bulletsReturned            Int      @default(0)
  gunBulletsIssued           Int?     @default(0)
  gunBulletsUsed             Int?     @default(0)
  gunBulletsReturned         Int?     @default(0)
  pistolBulletsIssued        Int?     @default(0)
  pistolBulletsUsed          Int?     @default(0)
  pistolBulletsReturned      Int?     @default(0)
  weaponsJson                String?  @db.Text
  accessoriesIssuedJson      String   @db.Text
  accessoriesReturnedJson    String   @db.Text
  missingAccessories         String?  @db.Text
  damageInformation          String?  @db.Text
  returnReceivedBy           String
  receiverSignatureConfirmed Boolean  @default(true)
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now())

  lease                      Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("gun_returns")
}

model Alert {
  id                    String        @id @default(uuid())
  leaseId               String?
  gunId                 String?
  ammunitionId          String?
  accessoryId           String?
  type                  String        // OVERDUE_RETURN, LOW_AMMUNITION_STOCK, MISSING_ACCESSORY, DAMAGED_GUN
  severity              String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                String        @default("OPEN") // OPEN, RESOLVED
  message               String        @db.Text
  dataJson              String?       @db.Text
  notificationsSentJson String?       @db.Text
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  lease                 Lease?        @relation(fields: [leaseId], references: [id])
  gun                   Gun?          @relation(fields: [gunId], references: [id])
  ammunition            Ammunition?   @relation(fields: [ammunitionId], references: [id])
  accessory             Accessory?    @relation(fields: [accessoryId], references: [id])
  remarks               AlertRemark[]

  @@map("alerts")
}

model AlertRemark {
  id        String   @id @default(uuid())
  alertId   String?
  leaseId   String?
  officer   String
  remark    String   @db.Text
  userId    String?
  createdAt DateTime @default(now())

  alert     Alert?   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  lease     Lease?   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("alert_remarks")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String   // LOGIN, LOGOUT, CREATE_PERSON, UPDATE_PERSON, BLOCK_PERSON, CREATE_GUN, UPDATE_GUN, GUN_STATUS_CHANGED, CREATE_LEASE, CANCEL_LEASE, PROCESS_RETURN, AMMUNITION_RECEIVED, AMMUNITION_ISSUED, AMMUNITION_RETURNED, AMMUNITION_ADJUSTED, ACCESSORY_ISSUED, ACCESSORY_RETURNED, ACCESSORY_ADJUSTED, ROLE_CHANGED, PERMISSION_CHANGED, USER_STATUS_CHANGED, SETTINGS_CHANGED
  entityType String   // User, Person, Gun, Lease, GunReturn, Ammunition, Accessory, Alert, Setting
  entityId   String?
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("General")
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
